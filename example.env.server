#将此文件重命名为.env.server以生效
G_CLIENT_ID=
G_CLIENT_SECRET=
JWT_SECRET=
INIT_TABLE=true
ENABLE_CACHE=true
PRODUCTHUNT_API_TOKEN=
# 代理配置
HTTP_PROXY=http://ip:port
HTTPS_PROXY=http://ip:port
PROXY=http://ip:port
# 自动刷新（分钟），不设置或为0则不启用
CRON_INTERVAL=
# MySQL 配置（可选，用于新闻增量同步）
MYSQL_HOST=
MYSQL_PORT=13306
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_NEWSOLD_DB=newsold
MYSQL_NEWSNOW_DB=newsnow
# 腾讯云翻译 API（可选，用于英文新闻翻译）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=